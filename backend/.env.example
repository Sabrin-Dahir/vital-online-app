# MongoDB Atlas (required on Render/Heroku — set in the host dashboard, not in git)
# Atlas → Network Access → Add IP Address → Allow Access from Anywhere (0.0.0.0/0)
# Otherwise cloud hosts cannot reach your cluster.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/vitalguide?retryWrites=true&w=majority&appName=Cluster0

# Auth (required in production — use a long random string)
JWT_SECRET=change-me-in-production

# Host sets PORT automatically on Render/Heroku; local default is 5050
PORT=5050
NODE_ENV=production

# Web admin / frontend origin(s) for CORS
CLIENT_URL=https://169.58.179.28.sslip.io
PUBLIC_WEB_URL=https://169.58.179.28.sslip.io
# Optional comma-separated extra origins
# ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com
ALLOW_RENDER_ORIGINS=true
ALLOW_VERCEL_ORIGINS=true

# Email (optional — logs to console when not configured)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# ImageKit.io (required for profile photos + workout proof uploads)
# Dashboard → Developer Options → API Keys
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
